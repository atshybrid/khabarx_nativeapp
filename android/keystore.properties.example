# Copy this file to: android/keystore.properties
# IMPORTANT: android/keystore.properties is gitignored. Do NOT commit secrets.
#
# Use a REAL upload keystore (not debug.keystore)
# Example when the keystore is stored at android/app/khabarx-release.keystore
# (paths are relative to the android/ folder)

MYAPP_UPLOAD_STORE_FILE=app/khabarx-release.keystore
MYAPP_UPLOAD_KEY_ALIAS=YOUR_ALIAS
MYAPP_UPLOAD_STORE_PASSWORD=YOUR_STORE_PASSWORD
MYAPP_UPLOAD_KEY_PASSWORD=YOUR_KEY_PASSWORD
